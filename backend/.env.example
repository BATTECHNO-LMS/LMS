NODE_ENV=development
PORT=4000
API_VERSION=v1
DATABASE_URL=
# Optional. Neon non-pooler URL for migrations (host without `-pooler`).
# If unset, `scripts/start-production.js` derives it from DATABASE_URL automatically.
DIRECT_URL=
JWT_SECRET=your-local-dev-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:4000

# Storage — local | r2
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
S3_PUBLIC_BASE_URL=

# Cloudflare R2 (when STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lms-uploads
R2_ENDPOINT=
R2_REGION=auto
R2_PUBLIC_BASE_URL=
# Browser presigned uploads require bucket CORS — run: npm run r2:setup-cors

# Resend — set RESEND_API_KEY in .env (never commit the real key)
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@lms.battechno.com
EMAIL_OTP_EXPIRY_MINUTES=10
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_OTP_EXPIRY_MINUTES=10
PASSWORD_RESET_OTP_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=10

# AI — openai | gemini (empty = disabled)
AI_PROVIDER=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=gemini-2.0-flash-lite
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=900000
FIELD_TRAINING_AI_RATE_LIMIT_MAX=10
FIELD_TRAINING_AI_RATE_LIMIT_WINDOW_MS=900000

FILE_UPLOAD_RATE_LIMIT_MAX=30
FILE_UPLOAD_RATE_LIMIT_WINDOW_MS=900000

STUDENT_ROLE_CODE=student
SUPER_ADMIN_ROLE_CODE=super_admin
