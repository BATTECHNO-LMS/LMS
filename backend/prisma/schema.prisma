/* -------- Central notification rules engine (aligned to DB) -------- */

enum notification_rule_status {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum notification_priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum notification_aggregation_mode {
  NONE
  PER_ENTITY
  HOURLY_DIGEST
  DAILY_DIGEST
  WEEKLY_DIGEST
}

enum notification_channel {
  IN_APP
  NOTIFICATION_CENTER
  BELL
  POPUP
  TOP_BANNER
  EMAIL
  PUSH
}

enum notification_delivery_status {
  PENDING
  PROCESSING
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
  SKIPPED
}

enum notification_category {
  ACCOUNT
  OPPORTUNITY
  APPLICATION
  SESSION
  ATTENDANCE
  TASK
  TEST
  PROGRESS
  CERTIFICATE
  REPORT
  SUPPORT
  ANNOUNCEMENT
  SYSTEM
}

model notification_rules {
  id                       String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name_ar                  String                        @db.VarChar(255)
  event_type               String                        @db.VarChar(100)
  status                   notification_rule_status      @default(DRAFT)
  category                 notification_category
  priority                 notification_priority         @default(NORMAL)
  target_roles             String[]                      @default([])
  target_scope             Json?
  channels                 notification_channel[]        @default([IN_APP, NOTIFICATION_CENTER, BELL])
  is_critical              Boolean                       @default(false)
  requires_acknowledgement Boolean                       @default(false)
  aggregation_mode         notification_aggregation_mode @default(NONE)
  delay_seconds            Int                           @default(0)
  is_immediate             Boolean                       @default(true)
  user_can_disable         Boolean                       @default(true)
  extra_conditions         Json?
  version                  Int                           @default(1)
  created_by_id            String?                       @db.Uuid
  updated_by_id            String?                       @db.Uuid
  published_by_id          String?                       @db.Uuid
  published_at             DateTime?                     @db.Timestamptz(6)
  created_at               DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                      @default(now()) @db.Timestamptz(6)

  notification_templates notification_templates[]

  @@index([event_type], map: "idx_notification_rules_event")
  @@index([status], map: "idx_notification_rules_status")
  @@index([category], map: "idx_notification_rules_category")
}

model notification_templates {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rule_id               String                   @db.Uuid
  role_code             String                   @db.VarChar(50)
  channel               notification_channel     @default(IN_APP)
  title_template        String                   @db.VarChar(500)
  body_template         String
  action_label_template String?                  @db.VarChar(120)
  action_url_template   String?                  @db.VarChar(1000)
  locale                String                   @default("ar") @db.VarChar(10)
  version               Int                      @default(1)
  status                notification_rule_status @default(ACTIVE)
  created_by_id         String?                  @db.Uuid
  updated_by_id         String?                  @db.Uuid
  created_at            DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                 @default(now()) @db.Timestamptz(6)

  notification_rules notification_rules @relation(fields: [rule_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([rule_id, role_code, channel, locale], map: "uq_notification_templates_rule_role_channel_locale")
  @@index([rule_id], map: "idx_notification_templates_rule")
  @@index([role_code], map: "idx_notification_templates_role")
}

model notification_deliveries {
  id                   String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notification_id      String                       @db.Uuid
  channel              notification_channel
  status               notification_delivery_status @default(PENDING)
  attempt_count        Int                          @default(0)
  provider_message_id  String?                      @db.VarChar(255)
  sent_at              DateTime?                    @db.Timestamptz(6)
  delivered_at         DateTime?                    @db.Timestamptz(6)
  failed_at            DateTime?                    @db.Timestamptz(6)
  next_retry_at        DateTime?                    @db.Timestamptz(6)
  failure_code         String?                      @db.VarChar(80)
  failure_message_safe String?                      @db.VarChar(500)
  created_at           DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at           DateTime                     @default(now()) @db.Timestamptz(6)

  notifications notifications @relation(fields: [notification_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([notification_id], map: "idx_notification_deliveries_notification")
  @@index([channel], map: "idx_notification_deliveries_channel")
  @@index([status], map: "idx_notification_deliveries_status")
}

model notification_preferences {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String                @db.Uuid
  notification_category notification_category
  channel               notification_channel
  is_enabled            Boolean               @default(true)
  created_at            DateTime              @default(now()) @db.Timestamptz(6)
  updated_at            DateTime              @default(now()) @db.Timestamptz(6)

  @@unique([user_id, notification_category, channel], map: "uq_notification_preferences_user_cat_channel")
  @@index([user_id], map: "idx_notification_preferences_user")
}

model notification_digests {
  id           String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String                        @db.Uuid
  digest_key   String                        @db.VarChar(200)
  event_type   String                        @db.VarChar(100)
  entity_type  String?                       @db.VarChar(80)
  entity_id    String?                       @db.Uuid
  aggregation  notification_aggregation_mode @default(DAILY_DIGEST)
  item_count   Int                           @default(0)
  payload_json Json?
  status       String                        @default("OPEN") @db.VarChar(30)
  flush_at     DateTime?                     @db.Timestamptz(6)
  flushed_at   DateTime?                     @db.Timestamptz(6)
  created_at   DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at   DateTime                      @default(now()) @db.Timestamptz(6)

  @@unique([digest_key], map: "uq_notification_digests_key")
  @@index([user_id], map: "idx_notification_digests_user")
  @@index([flush_at, status], map: "idx_notification_digests_flush")
}

model notification_scheduled_jobs {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_key      String    @unique @db.VarChar(200)
  event_type   String    @db.VarChar(100)
  entity_type  String?   @db.VarChar(80)
  entity_id    String?   @db.Uuid
  run_at       DateTime  @db.Timestamptz(6)
  payload_json Json?
  status       String    @default("PENDING") @db.VarChar(30)
  processed_at DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @db.Timestamptz(6)

  @@index([run_at, status], map: "idx_notification_scheduled_jobs_run")
  @@index([event_type], map: "idx_notification_scheduled_jobs_event")
}

