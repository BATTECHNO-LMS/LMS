  updated_at              DateTime                             @default(now()) @db.Timestamptz(6)

  training_programs             training_programs              @relation(fields: [program_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  training_enrollments          training_enrollments           @relation(fields: [enrollment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  training_evaluation_templates training_evaluation_templates  @relation(fields: [template_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  training_evaluation_responses training_evaluation_responses?

  @@index([program_id], map: "idx_training_evaluation_assignments_program")
  @@index([user_id], map: "idx_training_evaluation_assignments_user")
  @@index([status], map: "idx_training_evaluation_assignments_status")
}

model training_evaluation_responses {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignment_id          String    @unique(map: "uq_training_evaluation_responses_assignment") @db.Uuid
  enrollment_id          String    @db.Uuid
  user_id                String    @db.Uuid
  status                 String    @default("DRAFT") @db.VarChar(40)
  answers_json           Json?
  scores_json            Json?
  nps_score              Int?
  nps_category           String?   @db.VarChar(20)
  overall_reaction_score Decimal?  @db.Decimal(8, 2)
  submitted_at           DateTime? @db.Timestamptz(6)
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @default(now()) @db.Timestamptz(6)

  training_evaluation_assignments training_evaluation_assignments @relation(fields: [assignment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  training_enrollments            training_enrollments            @relation(fields: [enrollment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  training_evaluation_answers     training_evaluation_answers[]

  @@index([enrollment_id], map: "idx_training_evaluation_responses_enrollment")
}

model training_evaluation_answers {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  response_id   String   @db.Uuid
  question_id   String   @db.Uuid
  numeric_value Decimal? @db.Decimal(8, 2)
  text_value    String?
  nps_category  String?  @db.VarChar(20)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  training_evaluation_responses training_evaluation_responses @relation(fields: [response_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  training_evaluation_questions training_evaluation_questions @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([response_id, question_id], map: "uq_training_evaluation_answers_response_question")
  @@index([response_id], map: "idx_training_evaluation_answers_response")
}

model training_individual_reports {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enrollment_id   String   @db.Uuid
  program_id      String   @db.Uuid
  organization_id String   @db.Uuid
  version         Int      @default(1)
  status          String   @default("GENERATED") @db.VarChar(40)
  snapshot_json   Json
  summary_text    String?
  generated_by    String?  @db.Uuid
  generated_at    DateTime @default(now()) @db.Timestamptz(6)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  training_enrollments training_enrollments @relation(fields: [enrollment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  training_programs    training_programs    @relation(fields: [program_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([enrollment_id, version], map: "uq_training_individual_reports_enrollment_version")
  @@index([program_id], map: "idx_training_individual_reports_program")
}

model training_course_reports {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  program_id          String   @db.Uuid
  organization_id     String   @db.Uuid
  cohort_id           String?  @db.Uuid
  version             Int      @default(1)
  status              String   @default("GENERATED") @db.VarChar(40)
  snapshot_json       Json
  generated_by        String?  @db.Uuid
  generated_at        DateTime @default(now()) @db.Timestamptz(6)
  finalization_mode   String?  @db.VarChar(40)
  finalization_reason String?
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @db.Timestamptz(6)

  training_programs training_programs @relation(fields: [program_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([program_id, cohort_id, version], map: "uq_training_course_reports_program_cohort_version")
  @@index([organization_id], map: "idx_training_course_reports_org")
}

model training_finalization_events {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  program_id          String   @db.Uuid
  organization_id     String   @db.Uuid
  cohort_id           String?  @db.Uuid
  mode                String   @db.VarChar(40)
  reason              String?
  acted_by            String   @db.Uuid
  eligible_count      Int      @default(0)
  completed_count     Int      @default(0)
  exceptional_count   Int      @default(0)
  enrollment_ids_json Json?
  result_json         Json?
  created_at          DateTime @default(now()) @db.Timestamptz(6)

  training_programs training_programs @relation(fields: [program_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([program_id], map: "idx_training_finalization_events_program")
