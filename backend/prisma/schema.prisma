  @@unique([lesson_id, student_id], map: "uq_course_lesson_progress")
  @@index([course_id, student_id], map: "idx_course_lesson_progress_course_student")
}

/// Per-lesson training config (task PDF, model answer, quiz, AI prompt).
model course_lesson_training {
  lesson_id           String   @id @db.Uuid
  task_instructions   String?
  task_file_url       String?
  task_file_name      String?  @db.VarChar(255)
  model_answer_url    String?
  model_answer_name   String?  @db.VarChar(255)
  correction_prompt   String?
  max_score           Int      @default(100)
  pass_score          Int      @default(60)
  upload_weight       Int      @default(30)
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @db.Timestamptz(6)

  course_lessons course_lessons @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model course_lesson_questions {
