/// Mobile push (FCM) device registrations. Additive; push delivery is disabled
/// unless FIREBASE_PUSH_ENABLED and service-account credentials are configured.
model mobile_push_registrations {
  id                              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                         String    @db.Uuid
  registration_token              String    @db.VarChar(512)
  platform                        String    @db.VarChar(16) // android|ios
  app_id                          String?   @db.VarChar(120)
  app_version                     String?   @db.VarChar(40)
  device_installation_id          String?   @db.VarChar(120)
  locale                          String?   @db.VarChar(16)
  notification_permission_status  String?   @db.VarChar(32)
  created_at                      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                      DateTime  @default(now()) @db.Timestamptz(6)
  last_seen_at                    DateTime  @default(now()) @db.Timestamptz(6)
  disabled_at                     DateTime? @db.Timestamptz(6)
  last_delivery_error             String?   @db.VarChar(500)
  last_delivery_error_at          DateTime? @db.Timestamptz(6)

  @@unique([registration_token], map: "uq_mobile_push_registration_token")
  @@index([user_id], map: "idx_mobile_push_user_id")
  @@index([user_id, disabled_at], map: "idx_mobile_push_user_active")
  @@index([last_seen_at], map: "idx_mobile_push_last_seen")
}

/// Issued micro-credential certificates (verification + lifecycle).
model certificates {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id          String             @db.Uuid
  cohort_id           String             @db.Uuid
  micro_credential_id String             @db.Uuid
  certificate_no      String             @unique @db.VarChar(80)
  verification_code   String             @unique @db.VarChar(64)
  qr_code_url         String?
  status              certificate_status @default(issued)
  issued_at           DateTime           @default(now()) @db.Timestamptz(6)
  created_at          DateTime           @default(now()) @db.Timestamptz(6)
  updated_at          DateTime           @default(now()) @db.Timestamptz(6)

  @@unique([student_id, cohort_id, micro_credential_id], map: "uq_certificates_student_cohort_mc")
  @@index([student_id], map: "idx_certificates_student_id")
  @@index([cohort_id], map: "idx_certificates_cohort_id")
  @@index([micro_credential_id], map: "idx_certificates_micro_credential_id")
  @@index([status], map: "idx_certificates_status")
}

/// Append-only audit trail (writes via internal helpers, not public POST).
model audit_logs {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String?  @db.Uuid
  university_id   String?  @db.Uuid
  organization_id String?  @db.Uuid
