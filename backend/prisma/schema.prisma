model notifications {
  id                       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                  String            @db.Uuid
  title                    String            @db.VarChar(255)
  body                     String?
  type                     notification_type @default(info)
  action_url               String?           @db.VarChar(2000)
  action_label             String?           @db.VarChar(120)
  is_read                  Boolean           @default(false)
  event_type               String?           @db.VarChar(100)
  category                 String?           @db.VarChar(50)
  priority                 String?           @db.VarChar(20)
  entity_type              String?           @db.VarChar(80)
  entity_id                String?           @db.Uuid
  rule_id                  String?           @db.Uuid
  template_id              String?           @db.Uuid
  actor_id                 String?           @db.Uuid
  is_critical              Boolean           @default(false)
  requires_acknowledgement Boolean           @default(false)
  read_at                  DateTime?         @db.Timestamptz(6)
  acknowledged_at          DateTime?         @db.Timestamptz(6)
  archived_at              DateTime?         @db.Timestamptz(6)
  clicked_at               DateTime?         @db.Timestamptz(6)
  deduplication_key        String?           @db.VarChar(300)
  created_at               DateTime          @default(now()) @db.Timestamptz(6)
  updated_at               DateTime          @default(now()) @db.Timestamptz(6)

  notification_deliveries notification_deliveries[]

  @@unique([deduplication_key], map: "uq_notifications_deduplication_key")
  @@index([is_read], map: "idx_notifications_is_read")
  @@index([user_id], map: "idx_notifications_user_id")
  @@index([user_id, created_at(sort: Desc)], map: "idx_notifications_user_created")
  @@index([user_id, is_read], map: "idx_notifications_user_read")
  @@index([event_type], map: "idx_notifications_event_type")
  @@index([category], map: "idx_notifications_category")
  @@index([archived_at], map: "idx_notifications_archived")
