model users {
  id                        String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name                 String                     @db.VarChar(255)
  email                     String                     @unique @db.VarChar(255)
  password_hash             String
  phone                     String?                    @db.VarChar(50)
  status                    user_status                @default(inactive)
  primary_university_id     String?                    @db.Uuid
  university_specialty_id   String?                    @db.Uuid
  specialty_id              String?                    @db.Uuid
  activated_at              DateTime?                  @db.Timestamptz(6)
  email_verified_at         DateTime?                  @db.Timestamptz(6)
  /// OTP | ADMIN | IMPORT — set when email is verified.
  email_verification_method email_verification_method?
  activated_by              String?                    @db.Uuid
  /// Preferred active organization for multi-assignment users (must match an active assignment).
  preferred_organization_id String?                    @db.Uuid
  status_public_message     String?                    @db.VarChar(500)
  last_login_at             DateTime?                  @db.Timestamptz(6)
  /// Official university student number used on Field Training evaluation reports. Never substitute the internal user UUID.
  university_student_number String?                    @db.VarChar(80)
  created_at                DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                   @default(now()) @db.Timestamptz(6)

  specialties                    specialties?                     @relation(fields: [specialty_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  university_specialty           university_specialties?          @relation(fields: [university_specialty_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  email_verification_otps        email_verification_otps[]
  password_reset_otps            password_reset_otps[]
  user_organization_assignments  user_organization_assignments[] @relation("UserOrganizationAssignments")
  assigned_organization_members  user_organization_assignments[] @relation("OrganizationAssignmentActor")
  field_training_supervisor_ratings field_training_supervisor_ratings[] @relation("FtSupervisorRatingStudent")
  field_training_final_evaluations field_training_final_evaluations[] @relation("FtFinalEvaluationStudent")

  @@index([primary_university_id], map: "idx_users_primary_university_id")
  @@index([university_specialty_id], map: "idx_users_university_specialty_id")
  @@index([specialty_id], map: "idx_users_specialty_id")
  @@index([email_verified_at], map: "idx_users_email_verified_at")
  @@index([status], map: "idx_users_status")
  @@index([primary_university_id, status], map: "idx_users_university_status")
  @@index([university_student_number], map: "idx_users_university_student_number")
  @@index([primary_university_id, university_student_number], map: "idx_users_university_student_number_scope")
}

model email_verification_otps {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
