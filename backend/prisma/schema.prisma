  @@index([user_id], map: "idx_email_verification_otps_user_id")
  @@index([email], map: "idx_email_verification_otps_email")
  @@index([expires_at], map: "idx_email_verification_otps_expires_at")
}

model password_reset_otps {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                String?   @db.Uuid
  email                  String    @db.VarChar(255)
  code_hash              String
  reset_token_hash       String?
  reset_token_expires_at DateTime? @db.Timestamptz(6)
  expires_at             DateTime  @db.Timestamptz(6)
  used_at                DateTime? @db.Timestamptz(6)
  attempts_count         Int       @default(0)
  last_sent_at           DateTime  @db.Timestamptz(6)
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @default(now()) @db.Timestamptz(6)

  users users? @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([email], map: "idx_password_reset_otps_email")
  @@index([user_id], map: "idx_password_reset_otps_user_id")
  @@index([expires_at], map: "idx_password_reset_otps_expires_at")
  @@index([reset_token_hash], map: "idx_password_reset_otps_reset_token_hash")
}

/// Global academic specialties / majors â€” shared across all universities.
model specialties {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name_ar       String           @db.VarChar(255)
