/// Standalone LMS courses; visibility to students via course_cohorts (optional).
model courses {
  id                         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                      String        @db.VarChar(255)
  slug                       String        @unique @db.VarChar(255)
  short_description          String?
  description                String?
  cover_image_url            String?
  category                   String?       @db.VarChar(120)
  level                      course_level  @default(beginner)
  status                     course_status @default(draft)
  estimated_duration_minutes Int?
  created_by_id              String?       @db.Uuid
  published_at               DateTime?     @db.Timestamptz(6)
  created_at                 DateTime      @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime      @default(now()) @db.Timestamptz(6)

  course_sections        course_sections[]
  course_lessons         course_lessons[]
  course_enrollments     course_enrollments[]
  course_lesson_progress course_lesson_progress[]
  course_cohorts         course_cohorts[]

  @@index([status], map: "idx_courses_status")
  @@index([level], map: "idx_courses_level")
  @@index([created_by_id], map: "idx_courses_created_by_id")
}

model course_sections {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id  String   @db.Uuid
  title      String   @db.VarChar(255)
  sort_order Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  courses        courses          @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  course_lessons course_lessons[]

  @@index([course_id], map: "idx_course_sections_course_id")
}

model course_lessons {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id         String               @db.Uuid
  section_id        String               @db.Uuid
  title             String               @db.VarChar(255)
  description       String?
  type              course_lesson_type
  video_url         String?
  content           String?
  resource_url      String?
  duration_minutes  Int?
  sort_order        Int                  @default(0)
  is_preview        Boolean              @default(false)
  is_required       Boolean              @default(true)
  status            course_lesson_status @default(draft)
  created_at        DateTime             @default(now()) @db.Timestamptz(6)
  updated_at        DateTime             @default(now()) @db.Timestamptz(6)

  courses                courses                  @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  course_sections        course_sections          @relation(fields: [section_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  course_lesson_progress course_lesson_progress[]
  course_lesson_training course_lesson_training?
  course_lesson_questions course_lesson_questions[]
  course_lesson_student_workflow course_lesson_student_workflow[]

  @@index([course_id], map: "idx_course_lessons_course_id")
  @@index([section_id], map: "idx_course_lessons_section_id")
  @@index([status], map: "idx_course_lessons_status")
}

model course_cohorts {
  course_id  String   @db.Uuid
  cohort_id  String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  courses courses @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  cohorts cohorts @relation(fields: [cohort_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([course_id, cohort_id])
  @@index([cohort_id], map: "idx_course_cohorts_cohort_id")
}

model course_enrollments {
  id           String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id    String                   @db.Uuid
  student_id   String                   @db.Uuid
  status       course_enrollment_status @default(active)
  started_at   DateTime                 @default(now()) @db.Timestamptz(6)
  completed_at DateTime?                @db.Timestamptz(6)
  created_at   DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at   DateTime                 @default(now()) @db.Timestamptz(6)

  courses courses @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([course_id, student_id], map: "uq_course_enrollments")
  @@index([student_id], map: "idx_course_enrollments_student_id")
}

model course_lesson_progress {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id    String    @db.Uuid
  lesson_id    String    @db.Uuid
  student_id   String    @db.Uuid
  is_completed Boolean   @default(false)
  completed_at DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @db.Timestamptz(6)

  courses        courses        @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  course_lessons course_lessons @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([lesson_id, student_id], map: "uq_course_lesson_progress")
  @@index([course_id, student_id], map: "idx_course_lesson_progress_course_student")
}

/// Per-lesson training config (task PDF, model answer, quiz, AI prompt).
model course_lesson_training {
  lesson_id           String   @id @db.Uuid
  task_instructions   String?
  task_file_url       String?
  task_file_name      String?  @db.VarChar(255)
  model_answer_url    String?
  model_answer_name   String?  @db.VarChar(255)
  correction_prompt   String?
  max_score           Int      @default(100)
  pass_score          Int      @default(60)
  upload_weight       Int      @default(30)
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @db.Timestamptz(6)

  course_lessons course_lessons @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model course_lesson_questions {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lesson_id       String   @db.Uuid
  question_text   String
  code_snippet    String?
  points          Int      @default(5)
  sort_order      Int      @default(0)
  expected_answer String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  course_lessons course_lessons @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([lesson_id], map: "idx_course_lesson_questions_lesson_id")
}

/// Student progress through the 6-step lesson workflow.
model course_lesson_student_workflow {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id             String    @db.Uuid
  lesson_id             String    @db.Uuid
  student_id            String    @db.Uuid
  started_at            DateTime? @db.Timestamptz(6)
  submission_file_path  String?
  submission_file_name  String?   @db.VarChar(255)
  submission_size_bytes Int?
  submitted_at          DateTime? @db.Timestamptz(6)
  answers_json          Json?
  upload_score          Int?
  quiz_score            Int?
  total_score           Int?
  passed                Boolean?
  feedback_summary      String?
  correction_details    String?
  finished_at           DateTime? @db.Timestamptz(6)
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @db.Timestamptz(6)

  course_lessons course_lessons @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([lesson_id, student_id], map: "uq_course_lesson_student_workflow")
  @@index([course_id, student_id], map: "idx_course_lesson_workflow_course_student")
}

enum course_level {
  beginner
  intermediate
  advanced
  all_levels
}

enum course_status {
  draft
  published
  archived
}

enum course_lesson_type {
  video
  text
  link
  file
}

enum course_lesson_status {
  draft
  published
}

enum course_enrollment_status {
  active
  completed
}

/// Field training opportunities (independent from courses / cohorts).
model field_training_opportunities {
  id                   String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                String                            @db.VarChar(255)
  slug                 String                            @unique @db.VarChar(255)
  organization_name    String?                           @db.VarChar(255)
  university_id        String?                           @db.Uuid
  specialty_id         String?                           @db.Uuid
  assigned_instructor_id String?                         @db.Uuid
  location             String                            @db.VarChar(255)
  training_mode        field_training_mode
  short_description    String?
  description          String?
  requirements         String?
  benefits             String?
  seats_limit          Int?
  start_date           DateTime?                         @db.Date
  end_date             DateTime?                         @db.Date
  application_deadline DateTime?                         @db.Date
  requires_pre_assessment          Boolean               @default(true)
  requires_post_assessment         Boolean               @default(true)
  requires_final_task              Boolean               @default(true)
  minimum_attendance_percentage    Int?
  minimum_post_assessment_score    Decimal?              @db.Decimal(5, 2)
  completion_rules                 Json?
  status               field_training_opportunity_status @default(draft)
  training_started_at  DateTime?                         @db.Timestamptz(6)
  created_by_id        String?                           @db.Uuid
  published_at         DateTime?                         @db.Timestamptz(6)
  created_at           DateTime                          @default(now()) @db.Timestamptz(6)
  updated_at           DateTime                          @default(now()) @db.Timestamptz(6)

  universities                universities?                 @relation(fields: [university_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  specialties                 specialties?                  @relation(fields: [specialty_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  field_training_applications field_training_applications[]
  field_training_tasks        field_training_tasks[]
  field_training_sessions     field_training_sessions[]
  field_training_assessments  field_training_assessments[]
  field_training_completion_letters field_training_completion_letters[]
  field_training_opportunity_eligibility field_training_opportunity_eligibility[]

  @@index([status], map: "idx_field_training_opportunities_status")
  @@index([training_mode], map: "idx_field_training_opportunities_mode")
  @@index([created_by_id], map: "idx_field_training_opportunities_created_by")
  @@index([university_id], map: "idx_field_training_opportunities_university")
  @@index([specialty_id], map: "idx_field_training_opportunities_specialty")
  @@index([assigned_instructor_id], map: "idx_field_training_opportunities_instructor")
}

/// Eligible university programs for a field training opportunity (visibility + reporting).
model field_training_opportunity_eligibility {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  opportunity_id          String   @db.Uuid
  university_id           String   @db.Uuid
  university_specialty_id String   @db.Uuid
  canonical_specialty_id  String?  @db.Uuid
  seats_limit             Int?
  is_active               Boolean  @default(true)
  created_at              DateTime @default(now()) @db.Timestamptz(6)
  updated_at              DateTime @default(now()) @db.Timestamptz(6)

  field_training_opportunities field_training_opportunities @relation(fields: [opportunity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  universities               universities               @relation(fields: [university_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  university_specialties     university_specialties     @relation(fields: [university_specialty_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  specialties                specialties?               @relation(fields: [canonical_specialty_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([opportunity_id, university_id, university_specialty_id], map: "uq_ft_opportunity_eligibility")
  @@index([opportunity_id], map: "idx_ft_opportunity_eligibility_opportunity")
  @@index([university_id], map: "idx_ft_opportunity_eligibility_university")
  @@index([university_specialty_id], map: "idx_ft_opportunity_eligibility_university_specialty")
  @@index([canonical_specialty_id], map: "idx_ft_opportunity_eligibility_canonical")
  @@index([is_active], map: "idx_ft_opportunity_eligibility_active")
  @@index([university_id, is_active], map: "idx_ft_opportunity_eligibility_university_active")
}

/// Application doubles as the training participant record (one row per student per opportunity).
model field_training_applications {
  id              String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  opportunity_id  String                            @db.Uuid
  student_id      String                            @db.Uuid
  status          field_training_application_status @default(pending)
  training_status field_training_training_status    @default(none)
  student_message String?
  admin_note      String?
  reviewed_by_id  String?                           @db.Uuid
  reviewed_at     DateTime?                         @db.Timestamptz(6)
  training_started_at DateTime?                     @db.Timestamptz(6)
  pre_assessment_score Decimal?                     @db.Decimal(6, 2)
  pre_assessment_level field_training_knowledge_level?
  post_assessment_score Decimal?                    @db.Decimal(6, 2)
  attendance_percentage Decimal?                    @db.Decimal(5, 2)
  final_task_status field_training_final_task_status @default(not_required)
  completion_eligibility_status field_training_completion_eligibility_status @default(pending)
  eligibility_reason Json?
  expelled_at     DateTime?                         @db.Timestamptz(6)
  expelled_by_id  String?                           @db.Uuid
  expulsion_reason String?
  completion_letter_issued_at DateTime?             @db.Timestamptz(6)
  created_at      DateTime                          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime                          @default(now()) @db.Timestamptz(6)

  field_training_opportunities field_training_opportunities @relation(fields: [opportunity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  field_training_task_submissions field_training_task_submissions[]
  field_training_attendance    field_training_attendance[]
  field_training_assessment_attempts field_training_assessment_attempts[]
  field_training_completion_letters field_training_completion_letters[]

  @@unique([opportunity_id, student_id], map: "uq_field_training_applications")
  @@index([opportunity_id], map: "idx_field_training_applications_opportunity")
  @@index([student_id], map: "idx_field_training_applications_student")
  @@index([status], map: "idx_field_training_applications_status")
  @@index([training_status], map: "idx_field_training_applications_training_status")
  @@index([opportunity_id, status], map: "idx_field_training_applications_opportunity_status")
  @@index([student_id, created_at(sort: Desc)], map: "idx_field_training_applications_student_created")
}

enum field_training_mode {
  onsite
  remote
  hybrid
}

enum field_training_opportunity_status {
  draft
  published
  in_progress
  archived
}

enum field_training_application_status {
  pending
  approved
  rejected
  cancelled
}

/// Post-approval participant lifecycle (application `status` stays pending/approved/rejected/cancelled).
enum field_training_training_status {
  none
  pre_assessment_pending
  pre_assessment_completed
  ready_for_training
  in_training
  task_pending
  task_submitted
  post_assessment_pending
  post_assessment_completed
  eligible_for_completion
  completed
  failed
  expelled
}

enum field_training_knowledge_level {
  beginner
  intermediate
  advanced
}

enum field_training_final_task_status {
  not_required
  pending
  submitted
  approved
  rejected
}

enum field_training_completion_eligibility_status {
  pending
  eligible
  ineligible
  needs_review
}

enum field_training_attendance_status {
  present
  absent
  late
  excused
}

enum field_training_assessment_type {
  pre
  post
}

enum field_training_assessment_status {
  draft
  published
  closed
}

enum field_training_question_type {
  multiple_choice
  true_false
  short_answer
}

enum field_training_task_review_status {
  pending
  approved
  rejected
  needs_revision
}

enum field_training_completion_letter_status {
  issued
  revoked
}

model field_training_tasks {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  opportunity_id String   @db.Uuid
  title          String   @db.VarChar(255)
  description    String?
  sort_order     Int      @default(0)
  due_date       DateTime? @db.Date
  ai_self_evaluation_prompt String?
  requires_ai_self_evaluation Boolean @default(false)
  is_final_task  Boolean  @default(false)
  instruction_file_path String? @db.VarChar(500)
  instruction_file_name String? @db.VarChar(255)
  instruction_file_mime_type String? @db.VarChar(120)
  instruction_file_size Int?
  instruction_file_uploaded_at DateTime? @db.Timestamptz(6)
  instruction_file_uploaded_by_id String? @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)

  field_training_opportunities    field_training_opportunities    @relation(fields: [opportunity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  field_training_task_submissions field_training_task_submissions[]

  @@index([opportunity_id], map: "idx_field_training_tasks_opportunity")
}

model field_training_task_submissions {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id        String   @db.Uuid
  application_id String   @db.Uuid
  student_id     String   @db.Uuid
  student_self_evaluation_input String?
  ai_prompt_used String?
  ai_model_provider String? @db.VarChar(80)
  ai_model_name  String?  @db.VarChar(120)
  ai_raw_response String?
  ai_response_inserted_text String?
  final_student_notes String?
  ai_evaluated_at DateTime? @db.Timestamptz(6)
  file_path      String   @db.VarChar(500)
  file_name      String   @db.VarChar(255)
  mime_type      String?  @db.VarChar(120)
  submitted_at   DateTime @default(now()) @db.Timestamptz(6)
  is_late        Boolean  @default(false)
  review_status  field_training_task_review_status @default(pending)
  instructor_feedback String?
  reviewed_by_id String?  @db.Uuid
  reviewed_at    DateTime? @db.Timestamptz(6)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)

  field_training_tasks        field_training_tasks        @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  field_training_applications field_training_applications @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([task_id, application_id], map: "uq_field_training_task_submissions")
  @@index([student_id], map: "idx_field_training_task_submissions_student")
  @@index([review_status], map: "idx_field_training_task_submissions_review_status")
  @@index([application_id], map: "idx_field_training_task_submissions_application")
}

model field_training_sessions {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  opportunity_id String   @db.Uuid
  title          String   @db.VarChar(255)
  description    String?
  session_date   DateTime @db.Date
  start_time     String   @db.VarChar(8)
  end_time       String   @db.VarChar(8)
  zoom_link      String?  @db.VarChar(2000)
  is_required    Boolean  @default(true)
  created_by_id  String?  @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)

  field_training_opportunities field_training_opportunities @relation(fields: [opportunity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  field_training_attendance    field_training_attendance[]

  @@index([opportunity_id], map: "idx_field_training_sessions_opportunity")
  @@index([session_date], map: "idx_field_training_sessions_date")
}

/// Attendance rule: percentage uses required sessions only.
/// present + late + excused count as attended; absent does not.
model field_training_attendance {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id     String   @db.Uuid
  application_id String   @db.Uuid
  student_id     String   @db.Uuid
  status         field_training_attendance_status
  note           String?
  recorded_by_id String?  @db.Uuid
  recorded_at    DateTime @default(now()) @db.Timestamptz(6)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)

  field_training_sessions     field_training_sessions     @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  field_training_applications field_training_applications @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([session_id, application_id], map: "uq_field_training_attendance_session_application")
  @@index([student_id], map: "idx_field_training_attendance_student")
  @@index([application_id], map: "idx_field_training_attendance_application")
}

model field_training_assessments {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  opportunity_id String   @db.Uuid
  type           field_training_assessment_type
  title          String   @db.VarChar(255)
  description    String?
  passing_score  Decimal? @db.Decimal(5, 2)
  status         field_training_assessment_status @default(draft)
  created_by_id  String?  @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)

  field_training_opportunities field_training_opportunities @relation(fields: [opportunity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  field_training_assessment_questions field_training_assessment_questions[]
  field_training_assessment_attempts  field_training_assessment_attempts[]

  @@unique([opportunity_id, type], map: "uq_field_training_assessments_opportunity_type")
  @@index([opportunity_id], map: "idx_field_training_assessments_opportunity")
  @@index([status], map: "idx_field_training_assessments_status")
}

model field_training_assessment_questions {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessment_id  String   @db.Uuid
  question_text  String
  question_type  field_training_question_type
  options        Json?
  correct_answer Json?
  points         Decimal  @default(1) @db.Decimal(6, 2)
  sort_order     Int      @default(0)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)

  field_training_assessments field_training_assessments @relation(fields: [assessment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([assessment_id], map: "idx_field_training_assessment_questions_assessment")
}

model field_training_assessment_attempts {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessment_id  String   @db.Uuid
  application_id String   @db.Uuid
  student_id     String   @db.Uuid
  answers        Json?
  score          Decimal? @db.Decimal(6, 2)
  max_score      Decimal? @db.Decimal(6, 2)
  level          field_training_knowledge_level?
  submitted_at   DateTime? @db.Timestamptz(6)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)

  field_training_assessments  field_training_assessments  @relation(fields: [assessment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  field_training_applications field_training_applications @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([assessment_id, application_id], map: "uq_field_training_assessment_attempts")
  @@index([student_id], map: "idx_field_training_assessment_attempts_student")
}

model field_training_completion_letters {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  application_id String   @db.Uuid
  student_id     String   @db.Uuid
  opportunity_id String   @db.Uuid
  letter_no      String   @unique @db.VarChar(80)
  status         field_training_completion_letter_status @default(issued)
  issued_by_id   String?  @db.Uuid
  issued_at      DateTime @default(now()) @db.Timestamptz(6)
  pdf_url        String?
  verification_code String? @unique @db.VarChar(64)
  metadata       Json?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)

  field_training_applications  field_training_applications  @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  field_training_opportunities field_training_opportunities @relation(fields: [opportunity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([student_id], map: "idx_field_training_completion_letters_student")
  @@index([opportunity_id], map: "idx_field_training_completion_letters_opportunity")
  @@index([status], map: "idx_field_training_completion_letters_status")
}

enum file_visibility {
  public
  private
}

model files {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String?         @db.Uuid
  created_by_id       String?         @db.Uuid
  related_entity_type String?         @db.VarChar(100)
  related_entity_id   String?         @db.Uuid
  original_name       String          @db.VarChar(500)
  storage_key         String          @unique @db.VarChar(1024)
  bucket              String          @db.VarChar(255)
  mime_type           String          @db.VarChar(255)
  size                BigInt
  visibility          file_visibility @default(private)
  url                 String?         @db.VarChar(2048)
  created_at          DateTime        @default(now()) @db.Timestamptz(6)
  updated_at          DateTime        @default(now()) @db.Timestamptz(6)
  deleted_at          DateTime?       @db.Timestamptz(6)

  @@index([user_id], map: "idx_files_user_id")
  @@index([created_by_id], map: "idx_files_created_by_id")
  @@index([related_entity_type, related_entity_id], map: "idx_files_related_entity")
  @@index([deleted_at], map: "idx_files_deleted_at")
}
