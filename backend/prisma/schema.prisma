model organizations {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type             organization_type
  name             String              @db.VarChar(255)
  name_en          String?             @db.VarChar(255)
  short_name       String?             @db.VarChar(80)
  code             String?             @unique(map: "uq_organizations_code") @db.VarChar(50)
  institution_kind institution_kind?
  website          String?             @db.VarChar(500)
  country          String?             @db.VarChar(120)
  city             String?             @db.VarChar(120)
  address          String?             @db.VarChar(500)
  contact_email    String?             @db.VarChar(255)
  contact_phone    String?             @db.VarChar(50)
  logo_url                            String?             @db.VarChar(1000)
  status                              organization_status @default(active)
  notes                               String?
  allows_public_trainee_registration  Boolean             @default(false)
  created_at                          DateTime            @default(now()) @db.Timestamptz(6)
  updated_at                          DateTime            @default(now()) @db.Timestamptz(6)

  universities                   universities[]
  organization_email_domains     organization_email_domains[]
  organization_branches          organization_branches[]
  organization_departments       organization_departments[]
  user_organization_assignments  user_organization_assignments[]
  training_programs              training_programs[]
  training_cohorts               training_cohorts[]
  training_trainer_assignments    training_trainer_assignments[]
  support_tickets                support_tickets[]
  kpi_targets                    kpi_targets[]
  kpi_snapshots                  kpi_snapshots[]
  kpi_alerts                     kpi_alerts[]

  @@index([type], map: "idx_organizations_type")
  @@index([status], map: "idx_organizations_status")
  @@index([name], map: "idx_organizations_name")
  @@index([allows_public_trainee_registration], map: "idx_organizations_public_reg")
}

model organization_email_domains {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  domain          String   @db.VarChar(255)
  is_active       Boolean  @default(true)
  is_primary      Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  organizations organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organization_id, domain], map: "uq_organization_email_domains_org_domain")
  @@index([organization_id], map: "idx_organization_email_domains_org")
  @@index([domain], map: "idx_organization_email_domains_domain")
}

model organization_branches {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  name            String   @db.VarChar(255)
  name_en         String?  @db.VarChar(255)
  code            String?  @db.VarChar(80)
  city            String?  @db.VarChar(120)
  address         String?  @db.VarChar(500)
  sort_order      Int      @default(0)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  organizations                 organizations                  @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization_departments      organization_departments[]
  user_organization_assignments user_organization_assignments[]
  training_cohorts              training_cohorts[]

  @@index([organization_id], map: "idx_organization_branches_org")
  @@index([organization_id, is_active, sort_order], map: "idx_organization_branches_org_active_sort")
  @@unique([organization_id, code], map: "uq_organization_branches_org_code")
}

model organization_departments {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  branch_id       String?  @db.Uuid
  name            String   @db.VarChar(255)
  name_en         String?  @db.VarChar(255)
  code            String?  @db.VarChar(80)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  organizations                 organizations                  @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization_branches         organization_branches?         @relation(fields: [branch_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  user_organization_assignments user_organization_assignments[]
  training_cohorts              training_cohorts[]

  @@index([organization_id], map: "idx_organization_departments_org")
  @@index([branch_id], map: "idx_organization_departments_branch")
  @@unique([organization_id, code], map: "uq_organization_departments_org_code")
}

model user_organization_assignments {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String   @db.Uuid
  organization_id String   @db.Uuid
  role_code       String   @db.VarChar(50)
  branch_id       String?  @db.Uuid
  department_id   String?  @db.Uuid
  job_title       String?  @db.VarChar(255)
  employee_number String?  @db.VarChar(100)
  is_active       Boolean  @default(true)
  assigned_by     String?  @db.Uuid
  assigned_at     DateTime @default(now()) @db.Timestamptz(6)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  users         users                  @relation("UserOrganizationAssignments", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assigned_by_user users?              @relation("OrganizationAssignmentActor", fields: [assigned_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  organizations organizations          @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization_branches organization_branches? @relation(fields: [branch_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  organization_departments organization_departments? @relation(fields: [department_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([user_id], map: "idx_user_org_assignments_user")
  @@index([organization_id], map: "idx_user_org_assignments_org")
  @@index([organization_id, role_code, is_active], map: "idx_user_org_assignments_org_role_active")
  @@index([user_id, is_active], map: "idx_user_org_assignments_user_active")
}

model training_programs {
  id                      String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id         String                  @db.Uuid
  type                    training_program_type   @default(TRAINING_COURSE)
  /// Stable business code for idempotent seeds / integrations (e.g. CPF-JOB-INTERVIEW-2026-08).
  code                    String?                 @unique(map: "uq_training_programs_code") @db.VarChar(80)
  title                   String                  @db.VarChar(255)
  description             String?
  field                   String?                 @db.VarChar(255)
  objectives              String?
  outcomes                String?
  level                   String?                 @db.VarChar(80)
  language                String?                 @db.VarChar(40)
  delivery_mode           String?                 @db.VarChar(40)
  required_hours          Decimal?                @db.Decimal(8, 2)
  required_attendance_pct Decimal?                @db.Decimal(5, 2)
  max_participants        Int?
  start_date              DateTime?               @db.Date
  end_date                DateTime?               @db.Date
  status                  training_program_status @default(DRAFT)
  /// Extra course config (short description, enrollment policy, branch scope, etc.).
  settings_json           Json?
  created_by              String?                 @db.Uuid
  created_at              DateTime                @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                @default(now()) @db.Timestamptz(6)

  organizations         organizations          @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  training_cohorts              training_cohorts[]
  training_assessments          training_assessments[]
