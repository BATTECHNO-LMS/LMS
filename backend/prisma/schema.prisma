  @@index([expires_at], map: "idx_password_reset_otps_expires_at")
  @@index([reset_token_hash], map: "idx_password_reset_otps_reset_token_hash")
}

/// Global academic specialties / majors — shared across all universities.
model specialties {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
