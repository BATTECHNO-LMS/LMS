/// Versioned branded institutional training reports (individual, course, cohort, trainer, evaluation, attendance, impact, certificates).
model training_official_reports {
  id                           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  report_type                  String   @db.VarChar(40)
  program_id                   String   @db.Uuid
  organization_id              String   @db.Uuid
  cohort_id                    String?  @db.Uuid
  enrollment_id                String?  @db.Uuid
  trainer_user_id              String?  @db.Uuid
  /// Deterministic scope fingerprint for unique(type, scope_key, version).
  scope_key                    String   @db.VarChar(255)
  version                      Int      @default(1)
  status                       String   @default("READY") @db.VarChar(40)
  snapshot_json                Json
  summary_text                 String?
  reference_code               String   @unique(map: "uq_training_official_reports_reference") @db.VarChar(80)
  verification_code            String   @unique(map: "uq_training_official_reports_verification") @db.VarChar(64)
  is_latest                    Boolean  @default(true)
  generated_by                 String?  @db.Uuid
  generated_at                 DateTime @default(now()) @db.Timestamptz(6)
  source_finalization_event_id String?  @db.Uuid
  pdf_path                     String?  @db.VarChar(500)
  excel_path                   String?  @db.VarChar(500)
  checksum                     String?  @db.VarChar(128)
  created_at                   DateTime @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime @default(now()) @db.Timestamptz(6)

  training_programs training_programs @relation(fields: [program_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([report_type, scope_key, version], map: "uq_training_official_reports_scope_version")
  @@index([organization_id], map: "idx_training_official_reports_org")
  @@index([program_id], map: "idx_training_official_reports_program")
  @@index([report_type], map: "idx_training_official_reports_type")
  @@index([enrollment_id], map: "idx_training_official_reports_enrollment")
  @@index([program_id, report_type, is_latest], map: "idx_training_official_reports_latest")
}

/// Institution course learning materials (URL or uploaded file metadata).
model training_materials {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  program_id       String    @db.Uuid
  organization_id  String    @db.Uuid
  cohort_id        String?   @db.Uuid
  session_id       String?   @db.Uuid
  title            String    @db.VarChar(255)
  description      String?
  material_type    String    @default("LINK") @db.VarChar(40)
  /// Optional external URL (may coexist with an uploaded file).
  url              String?   @db.VarChar(2000)
  storage_key      String?   @db.VarChar(500)
  mime_type        String?   @db.VarChar(120)
  /// Reference to shared `files` registry (R2/local) used by course uploads.
  file_id          String?   @db.Uuid
  duration_seconds Int?
  available_from   DateTime? @db.Timestamptz(6)
  meta_json        Json?
  visibility       String    @default("ENROLLED") @db.VarChar(40)
  is_published     Boolean   @default(true)
  sort_order       Int       @default(0)
  created_by       String?   @db.Uuid
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)

  training_programs training_programs @relation(fields: [program_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([program_id], map: "idx_training_materials_program")
  @@index([organization_id], map: "idx_training_materials_org")
  @@index([cohort_id], map: "idx_training_materials_cohort")
  @@index([material_type], map: "idx_training_materials_type")
  @@index([file_id], map: "idx_training_materials_file")
}

model kpi_definitions {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String   @unique @db.VarChar(80)
  name_ar      String   @db.VarChar(255)
  name_en      String?  @db.VarChar(255)
  category     String   @db.VarChar(80)
  formula_key  String   @db.VarChar(120)
  description  String?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)

  kpi_targets   kpi_targets[]
  kpi_snapshots kpi_snapshots[]
  kpi_alerts    kpi_alerts[]
}

model kpi_targets {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kpi_id          String   @db.Uuid
  organization_id String?  @db.Uuid
  program_id      String?  @db.Uuid
  cohort_id       String?  @db.Uuid
  target_value    Decimal  @db.Decimal(12, 4)
  warn_value      Decimal? @db.Decimal(12, 4)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  kpi_definitions kpi_definitions @relation(fields: [kpi_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations   organizations?  @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([kpi_id], map: "idx_kpi_targets_kpi")
  @@index([organization_id], map: "idx_kpi_targets_org")
}

model kpi_snapshots {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kpi_id          String   @db.Uuid
  organization_id String?  @db.Uuid
  program_id      String?  @db.Uuid
  cohort_id       String?  @db.Uuid
  value           Decimal  @db.Decimal(12, 4)
  sample_size     Int      @default(0)
  computed_at     DateTime @default(now()) @db.Timestamptz(6)
  metadata_json   Json?

  kpi_definitions kpi_definitions @relation(fields: [kpi_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations   organizations?  @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([kpi_id, computed_at], map: "idx_kpi_snapshots_kpi_computed")
  @@index([organization_id], map: "idx_kpi_snapshots_org")
}

model kpi_alerts {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kpi_id          String           @db.Uuid
  organization_id String?          @db.Uuid
  entity_type     String?          @db.VarChar(80)
  entity_id       String?          @db.Uuid
  status          kpi_alert_status
  message         String
  is_active       Boolean          @default(true)
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  resolved_at     DateTime?        @db.Timestamptz(6)

  kpi_definitions kpi_definitions @relation(fields: [kpi_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations   organizations?  @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organization_id, is_active], map: "idx_kpi_alerts_org_active")
  @@index([kpi_id], map: "idx_kpi_alerts_kpi")
}


