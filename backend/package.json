{
  "name": "battechno-lms-api",
  "version": "0.1.0",
  "private": true,
  "description": "BATTECHNO-LMS REST API",
  "main": "src/server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "seed:real-baseline": "node scripts/seed-real-baseline.js",
    "merge:specialties": "node scripts/merge-duplicate-specialties.js",
    "seed:test-accounts": "node scripts/seed-test-accounts.js",
    "cleanup:demo": "node scripts/cleanup-demo-data.js",
    "seed:demo": "node scripts/seed-demo.js",
    "seed:analytics-demo": "node scripts/seed-analytics-demo.js",
    "seed:auth": "node scripts/seed-auth-minimum.js",
    "test": "node --test tests/*.test.js",
    "r2:health": "node scripts/r2-health-check.js",
    "r2:setup-cors": "node scripts/r2-setup-cors.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1080.0",
    "@aws-sdk/s3-request-presigner": "^3.1080.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.0.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.22.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "puppeteer": "^24.43.1",
    "resend": "^6.17.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^6.0.0",
    "supertest": "^7.0.0"
  }
}
